# Manual-install reference unit. For new installs prefer `sudo scanopy-daemon install`, which
# generates and registers its own config.json-driven unit automatically. This file is kept for
# manual setups and older daemons: copy to /etc/systemd/system/, set ExecStart flags (or rely on
# config.json), then `systemctl daemon-reload && systemctl enable --now scanopy-daemon`.
[Unit]
Description=Scanopy Network Discovery Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/scanopy-daemon
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
